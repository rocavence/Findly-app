    "“%@” couldn't be copied or moved.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” couldn't be copied or moved."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」無法拷貝或搬移。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」をコピーまたは移動できませんでした。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "‘%@’을(를) 복사하거나 이동할 수 없습니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo copiar ni mover «%@»."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível copiar ou mover “%@”."
          }
        }
      }
    },
