    "The drawer closes when another app comes to the front. Off, it stays until you close it.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The drawer closes when another app comes to the front. Off, it stays until you close it."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "其他 App 跑到最前面時，抽屜會收起來。關掉的話，會一直留著直到你自己關。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ほかのアプリが前面に来るとドロワーが閉じます。オフにすると、自分で閉じるまで表示されたままです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 앱이 앞으로 오면 서랍이 닫힙니다. 끄면 직접 닫을 때까지 열려 있습니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El cajón se cierra cuando otra app pasa al frente. Si lo desactivas, se queda hasta que lo cierres."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A gaveta fecha quando outro app vem para a frente. Desativado, ela fica até você fechar."
          }
        }
      }
    },
