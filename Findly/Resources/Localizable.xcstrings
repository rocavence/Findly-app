        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已開啟。你能打開的檔案夾，Findly 都能打開。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オンです。あなたが開けるフォルダはすべて Findly でも開けます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "켜져 있습니다. 사용자가 열 수 있는 모든 폴더를 Findly도 열 수 있습니다."
          }
        },
        "es": {
          "stringUnit": {
