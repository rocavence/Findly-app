    "Choose what the drawer's sidebar shows. Favorites and Tags come from Finder, in Finder's order.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose what the drawer's sidebar shows. Favorites and Tags come from Finder, in Finder's order."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選擇抽屜側邊欄要顯示哪些項目。喜好項目與標籤來自 Finder，順序也和 Finder 相同。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ドロワーのサイドバーに表示する項目を選びます。よく使う項目とタグは Finder から、Finder と同じ順序で読み込みます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "서랍 사이드바에 표시할 항목을 선택합니다. 즐겨찾기와 태그는 Finder에서 같은 순서로 가져옵니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige qué muestra la barra lateral del cajón. Favoritos y Etiquetas vienen del Finder, en el mismo orden."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha o que a barra lateral da gaveta mostra. Favoritos e Etiquetas vêm do Finder, na mesma ordem."
          }
        }
      }
    },
