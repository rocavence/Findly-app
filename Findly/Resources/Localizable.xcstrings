    "Add ⌘, ⌃ or ⌥ to the shortcut.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add ⌘, ⌃ or ⌥ to the shortcut."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "快速鍵要加上 ⌘、⌃ 或 ⌥。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘、⌃、⌥ のいずれかを加えてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘, ⌃ 또는 ⌥을 함께 누르세요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade ⌘, ⌃ u ⌥ al atajo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicione ⌘, ⌃ ou ⌥ ao atalho."
          }
        }
      }
    },
    "Another app is using this shortcut, so it doesn't reach Findly. Choose a different one.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Another app is using this shortcut, so it doesn't reach Findly. Choose a different one."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "另一個 App 正在用這組快速鍵，Findly 收不到。請換一組。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ほかのアプリがこのショートカットを使っているため、Findly に届きません。別のものを選んでください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 앱이 이 단축키를 사용 중이라 Findly에 전달되지 않습니다. 다른 단축키를 선택하세요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Otra app usa este atajo, así que no llega a Findly. Elige otro."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Outro app está usando este atalho, então ele não chega ao Findly. Escolha outro."
          }
        }
      }
    },
