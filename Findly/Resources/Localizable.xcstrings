    "macOS is waiting for your OK in System Settings › Login Items.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS is waiting for your OK in System Settings › Login Items."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS 在等你到「系統設定 › 登入項目」同意。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS が「システム設定 › ログイン項目」で許可を待っています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS가 시스템 설정 › 로그인 항목에서 승인을 기다리고 있습니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS espera tu permiso en Ajustes del Sistema › Ítems de inicio."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O macOS aguarda sua permissão em Ajustes do Sistema › Itens de Início."
          }
        }
      }
    },
    "macOS needs to let Findly in. Turn on Full Disk Access for Findly, then come back.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS needs to let Findly in. Turn on Full Disk Access for Findly, then come back."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "需要 macOS 放行。替 Findly 打開「完整磁碟取用權」，再回來這裡。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS の許可が必要です。Findly の「フルディスクアクセス」をオンにしてから戻ってください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS의 허용이 필요합니다. Findly의 전체 디스크 접근 권한을 켠 다음 돌아오세요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS tiene que dejar entrar a Findly. Activa el acceso total al disco para Findly y vuelve."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O macOS precisa liberar o Findly. Ative o Acesso Total ao Disco para o Findly e volte."
          }
        }
      }
    },
    "macOS uses %@. Choose a different one, or turn it off in System Settings › Keyboard › Keyboard Shortcuts.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS uses %@. Choose a different one, or turn it off in System Settings › Keyboard › Keyboard Shortcuts."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS 已經在用 %@。請換一個，或到「系統設定 › 鍵盤 › 鍵盤快速鍵」把它關掉。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ は macOS が使っています。別のものを選ぶか、「システム設定 › キーボード › キーボードショートカット」でオフにしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS가 %@을(를) 사용 중입니다. 다른 단축키를 선택하거나 시스템 설정 › 키보드 › 키보드 단축키에서 끄세요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS usa %@. Elige otro o desactívalo en Ajustes del Sistema › Teclado › Atajos de teclado."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O macOS usa %@. Escolha outro ou desative-o em Ajustes do Sistema › Teclado › Atalhos de Teclado."
          }
        }
      }
    },
