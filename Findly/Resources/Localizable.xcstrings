    "Drag the drawer's inner edge to resize it. Width and height are remembered separately, up to 85% of the screen.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drag the drawer's inner edge to resize it. Width and height are remembered separately, up to 85% of the screen."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "拖曳抽屜內側的邊緣就能調整大小。寬度與高度分開記住，最多到螢幕的 85%。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ドロワーの内側の端をドラッグするとサイズを変更できます。幅と高さは別々に記憶され、最大で画面の 85% です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "서랍의 안쪽 가장자리를 드래그하여 크기를 조절합니다. 너비와 높이는 따로 기억되며 화면의 최대 85%까지입니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrastra el borde interior del cajón para cambiar su tamaño. El ancho y el alto se recuerdan por separado, hasta el 85 % de la pantalla."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Arraste a borda interna da gaveta para redimensioná-la. Largura e altura são lembradas separadamente, até 85% da tela."
          }
        }
      }
    },
