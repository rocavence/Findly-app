    "Where the toggle shortcut opens the drawer. The edge shortcuts always open on their own edge.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Where the toggle shortcut opens the drawer. The edge shortcuts always open on their own edge."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開關快速鍵會從哪一邊打開抽屜。四個邊的快速鍵一律從各自那一邊打開。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "開閉ショートカットでドロワーを表示する位置です。各辺のショートカットは常にその辺に表示します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "열기/닫기 단축키로 서랍을 여는 위치입니다. 가장자리 단축키는 항상 해당 가장자리에서 엽니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dónde abre el cajón el atajo para abrir o cerrar. Los atajos de cada borde siempre abren en su borde."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Onde o atalho de abrir/fechar abre a gaveta. Os atalhos de cada borda sempre abrem na própria borda."
          }
        }
      }
    },
