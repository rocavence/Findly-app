        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Findly はこのフォルダを開けません"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Findly가 이 폴더를 열 수 없습니다"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Findly no puede abrir esta carpeta"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Findly não pode abrir esta pasta"
          }
        }
      }
    },
    "Findly can't use that key. Try a letter, number, arrow or punctuation key.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Findly can't use that key. Try a letter, number, arrow or punctuation key."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Findly 不能用這個鍵，請改用字母、數字、方向鍵或標點符號鍵。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このキーは使えません。文字、数字、矢印、記号のキーを試してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 키는 사용할 수 없습니다. 문자, 숫자, 화살표 또는 문장 부호 키를 사용하세요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Findly no puede usar esa tecla. Prueba con una letra, un número, una flecha o un signo de puntuación."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Findly não pode usar essa tecla. Tente uma letra, número, seta ou pontuação."
          }
        }
      }
    },
    "Findly is up to date.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Findly is up to date."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Findly 已是最新版本。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Findly は最新です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Findly가 최신 버전입니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Findly está actualizado."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Findly está atualizado."
          }
        }
      }
    },
    "Findly keeps Finder's list one shortcut away, on every Space and over full-screen apps, and slides away when you're done. Drag a file out of it into whatever you're working on.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Findly keeps Finder's list one shortcut away, on every Space and over full-screen apps, and slides away when you're done. Drag a file out of it into whatever you're working on."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Findly 把 Finder 的列表放在一個快速鍵之外，每個桌面空間、全螢幕 App 上都叫得出來，用完就收走。把檔案從裡面直接拖到你正在用的地方。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Findly は Finder のリストをショートカットひとつで呼び出せるようにします。どの操作スペースでも、フルスクリーンのアプリの上でも表示でき、使い終わったら隠れます。ファイルはそこから作業中のアプリへドラッグするだけです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Findly는 Finder 목록을 단축키 하나로 불러옵니다. 모든 Space와 전체 화면 앱 위에서도 열리고, 다 쓰면 사라집니다. 파일을 끌어서 작업 중인 곳에 바로 놓으세요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Findly tiene la lista del Finder a un atajo de distancia, en cada Space y sobre las apps a pantalla completa, y se aparta cuando terminas. Arrastra un archivo desde ahí a lo que estés haciendo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Findly deixa a lista do Finder a um atalho de distância, em cada Space e sobre apps em tela cheia, e some quando você termina. Arraste um arquivo dela para o que estiver fazendo."
          }
        }
      }
    },
