    "%lld items couldn't be copied or moved.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld items couldn't be copied or moved."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "有 %lld 個項目無法拷貝或搬移。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 項目をコピーまたは移動できませんでした。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld개 항목을 복사하거나 이동할 수 없습니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudieron copiar ni mover %lld ítems."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível copiar ou mover %lld itens."
          }
        }
      }
    },
    "%lld items couldn't be moved to the Trash.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld items couldn't be moved to the Trash."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "有 %lld 個項目無法丟到垃圾桶。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 項目をゴミ箱に入れられませんでした。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld개 항목을 휴지통으로 이동할 수 없습니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudieron trasladar %lld ítems a la papelera."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível mover %lld itens para o Lixo."
          }
        }
      }
    },
    "A Finder-style drawer that slides in from any edge of the screen.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A Finder-style drawer that slides in from any edge of the screen."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "一個 Finder 風格的抽屜，從螢幕任何一邊滑出來。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画面のどの辺からも滑り出る、Finder 風のドロワー。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "화면의 어느 가장자리에서나 밀려 나오는 Finder 스타일 서랍."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un cajón al estilo del Finder que aparece desde cualquier borde de la pantalla."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma gaveta no estilo do Finder que desliza de qualquer borda da tela."
          }
        }
      }
    },
    "A name can't be empty.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A name can't be empty."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "名稱不能空白。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "名前を空にはできません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이름은 비워 둘 수 없습니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El nombre no puede estar vacío."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O nome não pode ficar vazio."
          }
        }
      }
    },
    "A name can't contain “/” or “:”.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A name can't contain “/” or “:”."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "名稱不能包含「/」或「:」。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "名前に「/」や「:」は使えません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이름에 ‘/’ 또는 ‘:’을 포함할 수 없습니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El nombre no puede contener «/» ni «:»."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O nome não pode conter “/” ou “:”."
          }
        }
      }
    },
    "A shortcut needs ⌘, ⌃ or ⌥. Press Esc to cancel. The toggle shortcut is ⌃` by default; VS Code uses it for its terminal, so it won't reach Findly while VS Code is in front.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A shortcut needs ⌘, ⌃ or ⌥. Press Esc to cancel. The toggle shortcut is ⌃` by default; VS Code uses it for its terminal, so it won't reach Findly while VS Code is in front."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "快速鍵要包含 ⌘、⌃ 或 ⌥，按 Esc 取消。開關抽屜預設是 ⌃`；VS Code 用它來開終端機，所以 VS Code 在最前面時按了不會傳到 Findly。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ショートカットには ⌘、⌃、⌥ のいずれかが必要です。Esc でキャンセルします。開閉の初期設定は ⌃` です。VS Code はこれをターミナルに使うため、VS Code が前面にあるときは Findly に届きません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "단축키에는 ⌘, ⌃ 또는 ⌥이 필요합니다. Esc를 눌러 취소합니다. 열기/닫기 기본값은 ⌃`입니다. VS Code가 터미널에 이 키를 사용하므로 VS Code가 앞에 있을 때는 Findly에 전달되지 않습니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un atajo necesita ⌘, ⌃ u ⌥. Pulsa Esc para cancelar. El atajo para abrir o cerrar es ⌃` por omisión; VS Code lo usa para su terminal, así que no llega a Findly mientras VS Code está al frente."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um atalho precisa de ⌘, ⌃ ou ⌥. Pressione Esc para cancelar. O atalho de abrir/fechar é ⌃` por padrão; o VS Code o usa para o terminal, então ele não chega ao Findly enquanto o VS Code está na frente."
          }
        }
      }
    },
