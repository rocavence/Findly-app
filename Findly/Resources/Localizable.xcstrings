    "Off. Desktop, Documents, Downloads, external drives and some other folders can't be opened until it's on.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Off. Desktop, Documents, Downloads, external drives and some other folders can't be opened until it's on."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "未開啟。在打開之前，桌面、文件、下載項目、外接磁碟和其他一些檔案夾都打不開。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オフです。オンにするまで、デスクトップ、書類、ダウンロード、外部ドライブなど一部のフォルダは開けません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "꺼져 있습니다. 켜기 전까지 데스크탑, 문서, 다운로드, 외장 드라이브 및 일부 폴더를 열 수 없습니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desactivado. Escritorio, Documentos, Descargas, los discos externos y algunas carpetas más no se pueden abrir hasta que lo actives."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Desativado. Mesa, Documentos, Transferências, discos externos e algumas outras pastas não abrem até você ativar."
          }
        }
      }
    },
    "On": {
      "localizations": {
