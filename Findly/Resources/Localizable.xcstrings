    "Show what Finder's sidebar shows. Findly checks Finder's settings every time the drawer opens.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show what Finder's sidebar shows. Findly checks Finder's settings every time the drawer opens."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Finder 側邊欄顯示什麼，這裡就顯示什麼。每次打開抽屜都會重新讀取 Finder 的設定。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Finder のサイドバーと同じ項目を表示します。ドロワーを開くたびに Finder の設定を読み込みます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Finder 사이드바와 같은 항목을 표시합니다. 서랍을 열 때마다 Finder 설정을 확인합니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra lo mismo que la barra lateral del Finder. Findly revisa los ajustes del Finder cada vez que abres el cajón."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra o mesmo que a barra lateral do Finder. O Findly verifica os ajustes do Finder sempre que a gaveta abre."
          }
        }
      }
    },
    "Sidebar": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sidebar"
          }
        },
