    "Files whose names start with a dot. ⌘⇧. in the drawer switches this too.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Files whose names start with a dot. ⌘⇧. in the drawer switches this too."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "名稱以句點開頭的檔案。在抽屜裡按 ⌘⇧. 也能切換。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "名前がピリオドで始まるファイルです。ドロワーで ⌘⇧. を押しても切り替えられます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이름이 마침표로 시작하는 파일입니다. 서랍에서 ⌘⇧.을 눌러도 전환됩니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Archivos cuyo nombre empieza por un punto. También se cambia con ⌘⇧. en el cajón."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Arquivos cujo nome começa com ponto. ⌘⇧. na gaveta também alterna isso."
          }
        }
      }
    },
