{
  "sourceLanguage": "en",
  "strings": {
    "NSDesktopFolderUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Findly shows your Desktop folder in the drawer."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Findly 會在抽屜裡顯示你的桌面檔案夾。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Findly はデスクトップフォルダをドロワーに表示します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Findly가 서랍에 데스크탑 폴더를 표시합니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Findly muestra tu carpeta Escritorio en el cajón."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Findly mostra sua pasta Mesa na gaveta."
          }
        }
      }
    },
