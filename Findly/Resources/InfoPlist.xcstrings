        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Findly はダウンロードフォルダをドロワーに表示します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Findly가 서랍에 다운로드 폴더를 표시합니다."
