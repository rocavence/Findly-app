          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Findly가 서랍에 문서 폴더를 표시합니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Findly muestra tu carpeta Documentos en el cajón."
