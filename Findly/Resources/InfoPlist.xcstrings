    "NSRemovableVolumesUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Findly shows the contents of external drives in the drawer."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Findly 會在抽屜裡顯示外接磁碟的內容。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Findly は外部ドライブの内容をドロワーに表示します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Findly가 서랍에 외장 드라이브의 내용을 표시합니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Findly muestra el contenido de los discos externos en el cajón."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Findly mostra o conteúdo de discos externos na gaveta."
          }
        }
